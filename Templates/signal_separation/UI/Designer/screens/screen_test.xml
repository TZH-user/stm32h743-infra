			pad_all="0"
		/>
		<style
			name="cal_field"
			bg_color="0x272c32"
			bg_opa="100%"
			border_color="0x626b75"
			border_width="1"
			radius="3"
			text_color="0xf2f3f4"
		/>
		<style
			name="cal_primary"
			bg_color="0x176b87"
			bg_opa="100%"
			border_color="0x80d6ff"
